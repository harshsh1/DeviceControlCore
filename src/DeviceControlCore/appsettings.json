{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/device-control-.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}{NewLine}{Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "DeviceControl": {
    "UpdateStateDirectory": "state/update",
    "PreInstallScriptTimeoutSeconds": 30,
    "PeripheralPingIntervalSeconds": 10,
    "PeripheralAckTimeoutSeconds": 2,
    "OsSettingsStateFilePath": "state/os-settings.json",
    "AuditLogPath": "audit/audit-log.jsonl"
  }
}
